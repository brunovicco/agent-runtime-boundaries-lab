# Canonical runtime
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/agent_runtime_boundaries
# Effect ledger connection pool sizing; defaults shown.
EFFECT_LEDGER_POOL_MIN_SIZE=1
EFFECT_LEDGER_POOL_MAX_SIZE=10
SPECIALIST_A2A_URL=http://127.0.0.1:8101/a2a
# To compare CrewAI with the same orchestrator, use http://127.0.0.1:8102/a2a.

# a2a-otel-kit / OTLP
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces

# Agno specialist-local persistence. This is intentionally NOT the global workflow state.
AGNO_DB_FILE=.data/agno-specialist.db
AGNO_TELEMETRY=false

# Inference backend for both Agno and CrewAI. Gateway is the default; no automatic fallback.
LLM_BACKEND=gateway
# Optional direct OpenAI mode: set LLM_BACKEND=openai and supply your own provider key.
# Gateway/PDP services and GOV* declarations are not required in this mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_OUTPUT_TOKENS=2000
OPENAI_REQUEST_TIMEOUT_SECONDS=60

# Governed LLM Gateway canonical consumer variables.
# SDK 1.1.0 base URL, WITHOUT /v1. Use port 8001 for the gateway to avoid the orchestrator's 8000.
# HTTPS is required except for literal loopback HTTP (127.0.0.1 or ::1).
# Workload must be authorized by the gateway's authenticated client binding.
GOVERNED_LLM_GATEWAY_URL=http://127.0.0.1:8001
GOVERNED_LLM_GATEWAY_API_KEY=replace-me
GOVERNED_LLM_GATEWAY_WORKLOAD=agent.orchestration
# Explicit caller declarations; choose values appropriate for the actual evidence payload.
GOVERNED_LLM_GATEWAY_RISK_LEVEL=high
GOVERNED_LLM_GATEWAY_DATA_CLASSIFICATION=confidential
GOVERNED_LLM_GATEWAY_MAX_OUTPUT_TOKENS=2000
GOVERNED_LLM_GATEWAY_PROVIDER_TIMEOUT_SECONDS=30
GOVERNED_LLM_GATEWAY_REQUEST_TIMEOUT_SECONDS=60
CREWAI_DISABLE_TELEMETRY=true
CREWAI_TRACING_ENABLED=false
CREWAI_DISABLE_VERSION_CHECK=true

# Demo controls
FAIL_AFTER_SPECIALIST_ONCE=false
